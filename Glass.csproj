<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <!-- Runs on Windows 10 2004+; built against the Windows 11 SDK for Windows.Graphics.Capture
         (mirroring a covered window) and its borderless option, which is Windows 11 only. -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the Windows build be made on a Mac. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- One file, nothing to install: the .NET runtime travels inside Glass.exe.
         Self-contained either way, because the Store resolves no .NET runtime dependency and
         a framework-dependent package would simply fail to start on a PC without .NET 8.

         For the Store (GlassMsix=true) the single file is turned off. An MSIX is already one
         deliverable, so it buys nothing there, and it costs a lot: MSIX ships and updates in
         64 KB blocks and hard-links what has not changed, which one opaque 60 MB blob
         defeats, making every update a full download. It also breaks Assembly.Location and
         extracts itself to %TEMP% on every launch. Trimming is off in both: it fails
         silently, and WinForms leans on reflection. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile Condition="'$(GlassMsix)' != 'true'">true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(GlassMsix)' != 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(GlassMsix)' != 'true'">true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>

    <!-- tools/ holds test harnesses with stand-in types; dist/ holds the published zip. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tools/**;dist/**</DefaultItemExcludes>
    <AssemblyName>Glass</AssemblyName>
    <RootNamespace>Glass</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>Glass.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <Product>Glass</Product>
    <AssemblyTitle>Glass</AssemblyTitle>
    <Description>Mirror a screen region as an always-on-top overlay that clicks through to the real thing.</Description>
    <Version>1.3.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <FileVersion>1.3.0.0</FileVersion>
    <Copyright>Ridou</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Glass.ico" LogicalName="Glass.ico" />
    <!-- Marcellus stands in for the flared serif the look wants; OFL, so it ships with its licence. -->
    <EmbeddedResource Include="fonts\Marcellus-Regular.ttf" LogicalName="Marcellus-Regular.ttf" />
    <!-- Beside Glass.exe in the published folder, not packed inside it. -->
    <None Include="README.txt" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
